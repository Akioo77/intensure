{
  // 环境配置（v3.21.0）
  // 这个文件描述"当前被监测的网络长什么样"。
  // 换环境时改这里，不用改代码。
  //
  // 路径优先级：$INTENSURE_ENV_FILE > env.json > env.yaml
  // 删掉这个文件也能跑 —— 会用 env_config.py 里的内置默认值（= 改造前的行为）。
  //
  // 字段说明见 env_config.py 顶部文档。

  // 环境标签，给人看的，会出现在 GET /api/capabilities 输出里
  "environment": "mininet-lab",

  // 模式：
  //   active    —— 允许本模块做写操作（注故障）。本机实验环境用这个
  //   read-only —— 显式只读，任何写端点一律 403。接真实网络时必须用这个
  //
  // ⚠️ 注意（2026-11-03 订正）：这个开关**只管我们自己暴露的 REST 写端点**
  //    （/api/v1/test/inject-fault）。
  //    它**管不到控制器**：controller_app 会向交换机下发 OFPFlowMod ——
  //    握手时装 table-miss 规则（priority 0，所有未匹配包送控制器），
  //    学到 MAC 后装学习规则（priority 1，idle_timeout 30）。
  //    所以 controller_app 实际是个 **L2 学习交换机**，接管转发路径。
  //    接真实园区网络前**必须先处理这一项**（见 INTEGRATION_GUIDE.md §6.7.2）。
  "mode": "active",

  // 期望拓扑 —— 状态校验 completeness 维度用它
  // 换成别的网络时改这里，否则校验会误报"少了 1 台交换机"之类
  //
  // ⚠️ 注意 state['links'] 只记「交换机之间」的链路（LLDP 发现的），
  //    主机连交换机的链路不在里面。所以「链路数」看 inter_switch_links。
  //
  // 当前这份对应 start_all.sh / demo_db_pipeline.sh 起的拓扑
  // （SingleSwitchTopo(k=4)：1 交换机 4 主机）。
  // 跑 demo_full.py / integration_demo.py（topo_simple：2 交换机）时，
  // 用：export INTENSURE_ENV_FILE=env.topo_simple.json
  "topology_expect": {
    "switches": 1,
    "hosts": 4,
    "inter_switch_links": 0,
    "host_switch_links": 4,
    "total_links": 4,
    "expected_host_ips": ["10.0.0.1", "10.0.0.2", "10.0.0.3", "10.0.0.4"]
  },

  // dpid(hex) → 设备名。留空 = 按 dpid 末位推断（Mininet 跨机天然一致）
  // 真实设备 dpid 没规律时，在这里显式写：
  // "dpid_to_switch": {"0x245235fd8a4b": "sw-core-1"}
  "dpid_to_switch": {},

  // 真实端口名 → 契约短标签。Mininet 的 s1-eth1 天然就是契约要的 eth1，不用填。
  // 真实设备是 GigabitEthernet0/1 这种长名，要在这里映射：
  // "port_label_map": {"GigabitEthernet0/1": "eth1"}
  "port_label_map": {},

  // 探测参数：谁 ping 谁
  //
  // driver 决定「怎么测」：
  //   mininet —— 进 Mininet 主机命名空间发 ping（实验室环境，默认）
  //   icmp    —— 直接 ping（采集机与被测设备同网段时）
  //   snmp    —— SNMPv2c GetRequest，能应答即设备存活（真实园区标准做法）
  //   cli     —— 设备厂商 CLI（华为/H3C/Cisco 各不相同，用下面的模板）
  //
  // source / destination 决定「测什么」——这俩以前是死配置（没人读），现在真生效。
  "probe": {
    "driver": "mininet",
    "source": "10.0.0.1",
    "destination": "10.0.0.4",

    // driver=snmp 时用：设备地址 + 团体名 + 取哪个 OID
    // 默认 OID 是 sysUpTime.0（1.3.6.1.2.1.1.3.0）——能应答就说明设备活着
    "snmp": {
      "host": "",
      "port": 161,
      "community": "public",
      "oid": "1.3.6.1.2.1.1.3.0",
      "timeout": 3
    },

    // driver=cli 时用：命令模板（{dst}/{src} 会被替换）+ 两个解析正则
    // 例：华为 display interface brief / H3C ping / Cisco ping
    "cli": {
      "command": "ping -c 3 {dst}",
      "loss_regex": "([\\d.]+)% packet loss",
      "latency_regex": "avg[^=]*= ([\\d.]+)"
    }
  },

  // 接入目标 —— 「要在哪台设备上执行动作」（探测 / 注故障 / 读 OVS 日志）
  //
  //   type = "local" → 就在本机执行（默认，演示与自测照旧）
  //   type = "ssh"   → 通过 ssh 在目标主机上执行
  //
  // 什么时候用 ssh：
  //   ① 联调：Mininet 是**对方**起的，我们只负责采集 → 注故障/探测要落到对方那台机器
  //   ② 真实园区：采集机与设备不在同一台机器
  //
  // ⚠️ 采集链路本身（OpenFlow / LLDP / 状态 / 契约 HTTP / DB）本来就是跨机的，
  //    不受这个配置影响 —— 这里只管「要在设备上动手」的那部分。
  //
  // 远端机器需要免密 sudo（命令带 `sudo -n`，拿不到就立刻失败，不会卡在密码提示）
  "target": {
    "type": "local",
    "host": "",
    "user": "",
    "port": 22,
    "key": "",
    "connect_timeout": 5
  },

  // 状态文件路径（控制器写、REST API 读）—— 两者必须一致。
  // 跨机部署时指向共享盘，或让控制器与 API 同机部署。
  "state_file": "/tmp/network_state.json",

  // 是否允许注故障。接真实网络时必须 false —— 注故障是 sudo tc 打本机网卡，
  // 对着别人的设备发这类命令是事故。
  "allow_fault_injection": true,

  // 是否允许控制器向交换机下发流表规则（v3.19.0 新增）。
  // ⚠️ 这是接真实网络时**最关键**的一个开关：controller_app 握手时装
  //    table-miss 规则（priority 0，所有未匹配包送控制器）、学到 MAC 后装学习规则
  //    —— 它本质上是个 **L2 学习交换机**，指向真实园区交换机 = **接管其转发路径**。
  //    比注故障严重得多（allow_fault_injection 只挡住后者）。
  // mode=read-only 时这个开关**强制为 false**，不能被这里覆盖。
  // 关掉的代价：交换机不再把未匹配包送回控制器 → 没有 packet-in →
  //            **拿不到 MAC 级观测**（链路/端口状态仍可采）。
  "flow_rule_write": true,

  // 期望的对方契约版本。null = 用 assurance_bridge 的默认值（0.4.0）
  "assurance_expected_version": null
}
