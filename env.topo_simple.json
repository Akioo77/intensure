// 2 交换机演示环境（topo_simple）
//   demo_full.py / integration_demo.py 用的就是这套
//
// 用法：
//   export INTENSURE_ENV_FILE=env.topo_simple.json
//   然后再跑 demo_full.py 或 integration_demo.py
//
// 注意 state['links'] 只记「交换机之间」的链路（LLDP 发现的），
// 主机连交换机的链路不在里面。
// 所以 inter_switch_links = 1（s1-s2 那条），total_links = 5（含 4 条主机链路）。
{
  "environment": "mininet-lab-topo-simple",
  "mode": "active",
  "topology_expect": {
    "switches": 2,
    "hosts": 4,
    "inter_switch_links": 1,
    "host_switch_links": 4,
    "total_links": 5,
    "expected_host_ips": ["10.0.0.1", "10.0.0.2", "10.0.0.3", "10.0.0.4"]
  },
  "dpid_to_switch": {},
  "port_label_map": {},
  "probe": {
    "driver": "mininet",
    "source": "10.0.0.1",
    "destination": "10.0.0.4"
  },
  "allow_fault_injection": true,
  "assurance_expected_version": null
}
