# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
# ⚠️ 上面的 lib/ 是 Python 打包模板规则（匹配**任意层级**叫 lib 的目录），
#    会把 demo_scripts/lib/ 一起静默忽略掉 —— 联调脚本的公共 UI 库
#    就是这么"从来没进过版本库"的（git add 看不见它，也不报错）。
!demo_scripts/lib/
!demo_scripts/lib/*.sh

# Virtual env
venv/
env/
ENV/
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# 测试
.pytest_cache/
.coverage
htmlcov/
.tox/
.cache
coverage.xml

# 日志
*.log

# 环境变量
.env
.env.local
.env.*.local

# 编辑器临时文件
*~
*.bak
*.tmp

# 项目特定
/tmp/*.json
/tmp/*.log
/tmp/*.tmp
/tmp/intensure_*.log

# demo_scripts 运行时临时状态（每次跑联调生成，不入库）
demo_scripts/.[!.]*
